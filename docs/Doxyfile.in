# =============================================================================
#  Doxyfile template for OpenNPC.
#  Processed by CMake's configure_file(... @ONLY) so the @...@ tokens below are
#  substituted with the real project metadata.
# =============================================================================

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"

# -- Build ---------------------------------------------------------------------
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
INPUT                  = "@CMAKE_SOURCE_DIR@/include" \
                         "@CMAKE_SOURCE_DIR@/README.md"
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp *.md
EXCLUDE_PATTERNS       = */build/*

# -- Warnings ------------------------------------------------------------------
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

# -- Output --------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml

# -- Preprocessing -------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             =
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = "@CMAKE_SOURCE_DIR@/include"

# -- Source browser ------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# -- Diagram generation (requires Graphviz 'dot') ------------------------------
HAVE_DOT               = NO
UML_LOOK               = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
