# Configuration for the harnesses. Copy this file to .env and adjust it.
#
# Each client reads its own prefix, so the command line and the console one can talk
# to different models: `OPENANIMA_CLI_*` for the first, `OPENANIMA_TUI_*` for the
# second. The library itself reads no variable at all, it takes its configuration
# from the code that builds it.
#
# The cli harness reads this file on its own: it looks for .env in the working
# directory and up to three of its parents, so the CMake Tools buttons and the
# .vscode configurations find it with no extra wiring. Anything else has to load
# it into the environment of the process, for example
#
#     set -a && . ./.env && set +a
#
# Every backend that speaks the OpenAI chat-completions contract is configured the
# same way, so moving between a local model and a hosted one means editing the URL
# and the model name, nothing else.

# Local server (Ollama). No credentials needed.
OPENANIMA_CLI_BASE_URL=http://localhost:11434/v1
OPENANIMA_CLI_MODEL=qwen2.5:7b

# Bearer token. Empty sends no Authorization header, which is what a local server wants.
OPENANIMA_CLI_API_KEY=

# Hosted service (OpenAI and everything compatible with it). Comment out the block
# above before uncommenting this one.
# OPENANIMA_CLI_BASE_URL=https://api.openai.com/v1
# OPENANIMA_CLI_MODEL=gpt-4o
# OPENANIMA_CLI_API_KEY=sk-...

# Optional. The defaults are 60 seconds of silence allowed during a stream, a sampling
# temperature of 0.7 and a 512 token ceiling, and an empty value keeps the default
# rather than failing.
# OPENANIMA_CLI_TIMEOUT_SECONDS=60
# OPENANIMA_CLI_TEMPERATURE=0.7
# OPENANIMA_CLI_MAX_TOKENS=512

# The console client reads the same names under its own prefix. Uncomment and point them
# wherever it should go.
# OPENANIMA_TUI_BASE_URL=http://localhost:11434/v1
# OPENANIMA_TUI_MODEL=qwen2.5:7b
