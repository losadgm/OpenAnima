# Configuration for the cli harness. Copy this file to .env and adjust it.
#
# The binary does not read this file on its own: something has to load it into the
# environment of the process. Either source it in a shell
#
#     set -a && . ./.env && set +a
#
# or use one of the .vscode run configurations, which point at .env.

# API root. Ollama serves the OpenAI contract on http://localhost:11434/v1.
OPENANIMA_BASE_URL=http://localhost:11434/v1

# Model as the server knows it. `ollama list` prints the ones already pulled.
OPENANIMA_MODEL=qwen2.5:7b

# Bearer token. Empty sends no Authorization header, which is what a local server wants.
# OPENANIMA_API_KEY=

# Optional. The defaults are 60 seconds, 0.7 and 512 tokens, and an empty value keeps
# the default rather than failing.
# OPENANIMA_TIMEOUT_SECONDS=60
# OPENANIMA_TEMPERATURE=0.7
# OPENANIMA_MAX_TOKENS=512
