{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "labels": [
        "dependencies"
    ],
    "github-actions": {
        "enabled": false
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update FetchContent GIT_TAG pins in CMakeLists.txt",
            "managerFilePatterns": [
                "/(^|/)CMakeLists\\.txt$/"
            ],
            "matchStrings": [
                "GIT_REPOSITORY\\s+https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+?)(?:\\.git)?\\s+GIT_TAG\\s+(?<currentValue>v?[\\w.-]+)"
            ],
            "datasourceTemplate": "github-tags"
        }
    ],
    "packageRules": [
        {
            "description": "Open a single PR for all CMake FetchContent updates",
            "matchManagers": [
                "custom.regex"
            ],
            "groupName": "CMake dependencies"
        }
    ]
}